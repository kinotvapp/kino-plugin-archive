{
  "$comment": "Task 8q: plugin jobs' shared cases, run by the app (PluginJobsTest.kitParity) and the kit (test/jobs.test.mjs). manifests: the base manifest (a screen plugin with schedule and one job) with 'set' merged over it (null removes a key); ok, or the refusal's field and message (contract.json kinoJobs.manifest), and on success the parsed jobs' ids, everyMin and sorted everyOptions. budgets: one run's steps (fetch: a request and its answer's bytes; store: bytes written) and the first cap crossed (null: none), as JobRunBudget/jobBudget count them.",
  "base": {
    "id": "news", "name": "Noticias", "version": "1.0.0", "apiVersion": 14, "entry": "plugin.js", "hosts": ["news.google.com"],
    "capabilities": ["screen", "schedule"], "screen": { "label": "Noticias" },
    "jobs": [{ "id": "refresh", "label": { "es": "Actualizar", "en": "Refresh" }, "everyMin": 60, "everyOptions": [15, 30, 60, 180, 720, 1440] }]
  },
  "manifests": [
    { "name": "the base", "set": {}, "ok": true, "jobs": [{ "id": "refresh", "everyMin": 60, "everyOptions": [15, 30, 60, 180, 720, 1440] }] },
    { "name": "options are sorted", "set": { "jobs": [{ "id": "a", "label": { "es": "A" }, "everyMin": 30, "everyOptions": [1440, 30, 15] }] }, "ok": true, "jobs": [{ "id": "a", "everyMin": 30, "everyOptions": [15, 30, 1440] }] },
    { "name": "three jobs", "set": { "jobs": [
      { "id": "a", "label": { "es": "A" }, "everyMin": 15, "everyOptions": [15] },
      { "id": "b-2", "label": { "es": "B" }, "everyMin": 60, "everyOptions": [60] },
      { "id": "c", "label": { "es": "C", "en": "C" }, "everyMin": 1440, "everyOptions": [1440] }] }, "ok": true,
      "jobs": [{ "id": "a", "everyMin": 15, "everyOptions": [15] }, { "id": "b-2", "everyMin": 60, "everyOptions": [60] }, { "id": "c", "everyMin": 1440, "everyOptions": [1440] }] },
    { "name": "unknown keys of a job are ignored", "set": { "jobs": [{ "id": "a", "label": { "es": "A" }, "everyMin": 15, "everyOptions": [15], "later": 1 }] }, "ok": true, "jobs": [{ "id": "a", "everyMin": 15, "everyOptions": [15] }] },
    { "name": "four jobs", "set": { "jobs": [
      { "id": "a", "label": { "es": "A" }, "everyMin": 15, "everyOptions": [15] },
      { "id": "b", "label": { "es": "B" }, "everyMin": 15, "everyOptions": [15] },
      { "id": "c", "label": { "es": "C" }, "everyMin": 15, "everyOptions": [15] },
      { "id": "d", "label": { "es": "D" }, "everyMin": 15, "everyOptions": [15] }] }, "ok": false, "field": "jobs", "message": "jobsBad" },
    { "name": "no jobs at all", "set": { "jobs": [] }, "ok": false, "field": "jobs", "message": "jobsBad" },
    { "name": "jobs not a list", "set": { "jobs": { "id": "a" } }, "ok": false, "field": "jobs", "message": "jobsBad" },
    { "name": "schedule without jobs", "set": { "jobs": null }, "ok": false, "field": "capabilities", "message": "scheduleNeedsJobs" },
    { "name": "jobs without schedule", "set": { "capabilities": ["screen"] }, "ok": false, "field": "jobs", "message": "jobsNeedsCapability" },
    { "name": "below apiVersion 14 the capability is unknown", "set": { "apiVersion": 13, "capabilities": ["search", "resolve", "schedule"], "screen": null }, "ok": false, "field": "capabilities", "message": "The \"schedule\" capability needs apiVersion 14" },
    { "name": "never on its own", "set": { "capabilities": ["schedule"], "screen": null }, "ok": false, "field": "capabilities" },
    { "name": "Task 18 G2: enabledBy names a toggle setting", "set": { "settings": [{ "key": "auto", "type": "toggle", "label": "Automático", "default": true }], "jobs": [{ "id": "a", "label": { "es": "A" }, "everyMin": 15, "everyOptions": [15], "enabledBy": "auto" }] }, "ok": true, "jobs": [{ "id": "a", "everyMin": 15, "everyOptions": [15], "enabledBy": "auto" }] },
    { "name": "Task 18 G2: enabledBy null is the job's own switch", "set": { "settings": [{ "key": "auto", "type": "toggle", "label": "Automático", "default": true }], "jobs": [{ "id": "a", "label": { "es": "A" }, "everyMin": 15, "everyOptions": [15], "enabledBy": null }] }, "ok": true, "jobs": [{ "id": "a", "everyMin": 15, "everyOptions": [15], "enabledBy": null }] },
    { "name": "Task 18 G2: enabledBy naming a text setting", "set": { "settings": [{ "key": "name", "type": "text", "label": "Nombre" }], "jobs": [{ "id": "a", "label": { "es": "A" }, "everyMin": 15, "everyOptions": [15], "enabledBy": "name" }] }, "ok": false, "field": "jobs", "message": "badEnabledBy" },
    { "name": "Task 18 G2: enabledBy naming no setting", "set": { "jobs": [{ "id": "a", "label": { "es": "A" }, "everyMin": 15, "everyOptions": [15], "enabledBy": "auto" }] }, "ok": false, "field": "jobs", "message": "badEnabledBy" },
    { "name": "Task 18 G2: enabledBy not a string", "set": { "settings": [{ "key": "auto", "type": "toggle", "label": "Automático", "default": true }], "jobs": [{ "id": "a", "label": { "es": "A" }, "everyMin": 15, "everyOptions": [15], "enabledBy": true }] }, "ok": false, "field": "jobs", "message": "badEnabledBy" },
    { "name": "an id with a capital", "set": { "jobs": [{ "id": "Refresh", "label": { "es": "A" }, "everyMin": 15, "everyOptions": [15] }] }, "ok": false, "field": "jobs", "message": "badId" },
    { "name": "an id of 25 characters", "set": { "jobs": [{ "id": "aaaaaaaaaaaaaaaaaaaaaaaaa", "label": { "es": "A" }, "everyMin": 15, "everyOptions": [15] }] }, "ok": false, "field": "jobs", "message": "badId" },
    { "name": "two jobs with one id", "set": { "jobs": [{ "id": "a", "label": { "es": "A" }, "everyMin": 15, "everyOptions": [15] }, { "id": "a", "label": { "es": "B" }, "everyMin": 15, "everyOptions": [15] }] }, "ok": false, "field": "jobs", "message": "duplicateId" },
    { "name": "a label that is a string", "set": { "jobs": [{ "id": "a", "label": "A", "everyMin": 15, "everyOptions": [15] }] }, "ok": false, "field": "jobs", "message": "badLabel" },
    { "name": "a label without es", "set": { "jobs": [{ "id": "a", "label": { "en": "A" }, "everyMin": 15, "everyOptions": [15] }] }, "ok": false, "field": "jobs", "message": "badLabel" },
    { "name": "a label of only bidi marks", "set": { "jobs": [{ "id": "a", "label": { "es": "\u202e\u200f" }, "everyMin": 15, "everyOptions": [15] }] }, "ok": false, "field": "jobs", "message": "badLabel" },
    { "name": "a label of 41 characters", "set": { "jobs": [{ "id": "a", "label": { "es": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" }, "everyMin": 15, "everyOptions": [15] }] }, "ok": false, "field": "jobs", "message": "badLabel" },
    { "name": "an option under 15 minutes (WorkManager's floor)", "set": { "jobs": [{ "id": "a", "label": { "es": "A" }, "everyMin": 15, "everyOptions": [10, 15] }] }, "ok": false, "field": "jobs", "message": "badOptions" },
    { "name": "an option over a day", "set": { "jobs": [{ "id": "a", "label": { "es": "A" }, "everyMin": 15, "everyOptions": [15, 2880] }] }, "ok": false, "field": "jobs", "message": "badOptions" },
    { "name": "a fractional option", "set": { "jobs": [{ "id": "a", "label": { "es": "A" }, "everyMin": 15, "everyOptions": [15, 22.5] }] }, "ok": false, "field": "jobs", "message": "badOptions" },
    { "name": "a repeated option", "set": { "jobs": [{ "id": "a", "label": { "es": "A" }, "everyMin": 15, "everyOptions": [15, 15] }] }, "ok": false, "field": "jobs", "message": "badOptions" },
    { "name": "seven options", "set": { "jobs": [{ "id": "a", "label": { "es": "A" }, "everyMin": 15, "everyOptions": [15, 30, 60, 120, 180, 360, 720] }] }, "ok": false, "field": "jobs", "message": "badOptions" },
    { "name": "no options", "set": { "jobs": [{ "id": "a", "label": { "es": "A" }, "everyMin": 15, "everyOptions": [] }] }, "ok": false, "field": "jobs", "message": "badOptions" },
    { "name": "everyMin not among the options", "set": { "jobs": [{ "id": "a", "label": { "es": "A" }, "everyMin": 45, "everyOptions": [15, 30] }] }, "ok": false, "field": "jobs", "message": "badEvery" },
    { "name": "everyMin missing", "set": { "jobs": [{ "id": "a", "label": { "es": "A" }, "everyOptions": [15, 30] }] }, "ok": false, "field": "jobs", "message": "badEvery" },
    { "name": "runOn preferPhone (Task 8q-2)", "set": { "jobs": [{ "id": "a", "label": { "es": "A" }, "everyMin": 15, "everyOptions": [15], "runOn": "preferPhone" }] }, "ok": true, "jobs": [{ "id": "a", "everyMin": 15, "everyOptions": [15], "runOn": "preferPhone" }] },
    { "name": "runOn any", "set": { "jobs": [{ "id": "a", "label": { "es": "A" }, "everyMin": 15, "everyOptions": [15], "runOn": "any" }] }, "ok": true, "jobs": [{ "id": "a", "everyMin": 15, "everyOptions": [15], "runOn": "any" }] },
    { "name": "runOn absent is any", "set": { "jobs": [{ "id": "a", "label": { "es": "A" }, "everyMin": 15, "everyOptions": [15] }] }, "ok": true, "jobs": [{ "id": "a", "everyMin": 15, "everyOptions": [15], "runOn": "any" }] },
    { "name": "runOn null is any", "set": { "jobs": [{ "id": "a", "label": { "es": "A" }, "everyMin": 15, "everyOptions": [15], "runOn": null }] }, "ok": true, "jobs": [{ "id": "a", "everyMin": 15, "everyOptions": [15], "runOn": "any" }] },
    { "name": "runOn tv", "set": { "jobs": [{ "id": "a", "label": { "es": "A" }, "everyMin": 15, "everyOptions": [15], "runOn": "tv" }] }, "ok": false, "field": "jobs", "message": "badRunOn" },
    { "name": "runOn not a string", "set": { "jobs": [{ "id": "a", "label": { "es": "A" }, "everyMin": 15, "everyOptions": [15], "runOn": true }] }, "ok": false, "field": "jobs", "message": "badRunOn" },
    { "name": "runOn in another case", "set": { "jobs": [{ "id": "a", "label": { "es": "A" }, "everyMin": 15, "everyOptions": [15], "runOn": "PreferPhone" }] }, "ok": false, "field": "jobs", "message": "badRunOn" }
  ],
  "budgets": [
    { "name": "ten fetches are fine", "steps": [["fetch", 100], ["fetch", 100], ["fetch", 100], ["fetch", 100], ["fetch", 100], ["fetch", 100], ["fetch", 100], ["fetch", 100], ["fetch", 100], ["fetch", 100]], "crossed": null },
    { "name": "the eleventh fetch", "steps": [["fetch", 1], ["fetch", 1], ["fetch", 1], ["fetch", 1], ["fetch", 1], ["fetch", 1], ["fetch", 1], ["fetch", 1], ["fetch", 1], ["fetch", 1], ["fetch", 1]], "crossed": "cap_fetches" },
    { "name": "exactly 2 MB of answers", "steps": [["fetch", 1048576], ["fetch", 1048576]], "crossed": null },
    { "name": "one byte over 2 MB", "steps": [["fetch", 1048576], ["fetch", 1048577]], "crossed": "cap_bytes" },
    { "name": "exactly 256 KB stored", "steps": [["store", 131072], ["store", 131072]], "crossed": null },
    { "name": "a write past 256 KB", "steps": [["store", 262144], ["store", 1]], "crossed": "cap_storage" },
    { "name": "the first cap crossed stays", "steps": [["store", 262145], ["fetch", 1]], "crossed": "cap_storage" }
  ]
}
